{
  "name": "@gp/ui",
  "version": "0.1.3",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/loginov-a11y/gp-ui.git"
  },
  "description": "goodPayments UI-kit: компоненты, каркас кабинета, composables и утилиты",
  "main": "./dist/gp-ui.cjs",
  "module": "./dist/gp-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gp-ui.js",
      "require": "./dist/gp-ui.cjs"
    },
    "./styles/tokens.css": "./src/ui-kit/g-tokens.css",
    "./styles/date-picker.css": "./src/ui-kit/g-date-picker.css",
    "./styles/property-list.css": "./src/ui-kit/g-property-list.css",
    "./style.css": "./dist/ui.css"
  },
  "files": [
    "dist",
    "src/ui-kit/g-tokens.css",
    "src/ui-kit/g-date-picker.css",
    "src/ui-kit/g-property-list.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/fix-dts.mjs",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@vuepic/vue-datepicker": "^11.0.3",
    "lucide-vue-next": "^0.546.0",
    "vue": "^3.5.0",
    "vue-i18n": "^10.0.0 || ^11.0.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vuepic/vue-datepicker": "^11.0.3",
    "lucide-vue-next": "^0.546.0",
    "sass-embedded": "^1.93.2",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
